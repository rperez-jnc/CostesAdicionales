{procedure TdmdDatos.ActualizaCosteLineas(vIdAlbv, vCosteUnidad: double; vModificarCostesManuales:boolean);
var
  NaxAlbaran : albaran;
  NaxVarios : Varios;
  lUnidades : double;
  lCoste : double;
  lObtPrcCoste : string;
  lNUmLin : double;
  lCodArt, lCodAlm : string;
  lPrcCoste, lPrcCosteNew : double;
begin

  Naxvarios := coVarios.Create;
  NaxAlbaran := coAlbaran.Create;
  NaxAlbaran.Iniciar;

  with qLineasCoste do
  begin
    close;
    sql.Clear;

    sql.Add('Select codart, codalm, numlinalb, unidades, prcmedio,ObtPrcCoste from linealba with(nolock)');
    sql.Add('where idalbv = ' + formateafloatsql(vIdAlbv));

    open;

    first;

    while not eof do
    begin


      NaxAlbaran.Modifica(vIdAlbv, False);
      NaxAlbaran.OmitirMensajes := True;
      lNumlin :=fieldbyname('numlinalb').AsFloat;
      showmessage('NumLinALb: ' + floattostr(lNumLIn));
      NaxAlbaran.EditarLinea(lNumLin);
      showmessage('Editando linea');
      //lCoste := NaxAlbaran.AsFloatLin['PrcMedio'];

      lUnidades :=NaxAlbaran.AsFloatLin['Unidades'];

      lObtPrcCoste :=NaxAlbaran.AsStringLin['ObtPrcCoste'];
      lCodAlm := Fieldbyname('CodAlm').AsString;
      lCodArt := Fieldbyname('CodArt').AsString;


      if ((uppercase(lObtPrcCoste) <> 'MANU') or (vModificarCostesManuales)) then
      begin

        lPrcCoste := ifnull(NaxAlbaran.AsFloatLin['SOL_COSTEANTERIOR'],0);

         //lPrcCoste := NaxVarios.ObtPrecioMedio(lCodArt,lCodAlm);
         if ((vCosteUnidad = 0) and  (lPrcCoste = 0) and (uppercase(lObtPrcCoste) <> 'MANU')) then
         begin

              lPrcCoste := ifnull(NaxVarios.ObtPrecioCoste(lCodArt,lCodAlm,lObtPrcCoste),0);


              lPrcCosteNew := lPrcCoste +  vCosteUnidad;

              NaxAlbaran.AsFloatLin['PrcMedio'] := lPrcCosteNew;

              NaxAlbaran.AsStringLin['SOL_MODCOSTESADICIONALES'] := 'T';

         end
         else
         if ((vCosteUnidad <> 0) and  (lPrcCoste = 0) and (uppercase(lObtPrcCoste) <> 'MANU')) then
         begin

              lPrcCoste := ifnull(NaxVarios.ObtPrecioCoste(lCodArt,lCodAlm,lObtPrcCoste),0);

              NaxAlbaran.AsFloatLin['PrcMedio'] := ifnull(lPrcCoste +  vCosteUnidad,0);
              NaxAlbaran.AsStringLin['SOL_MODCOSTESADICIONALES'] := 'T';
         end
         else
         if uppercase(lObtPrcCoste) <> 'MANU' then
         begin

              NaxAlbaran.AsFloatLin['PrcMedio'] := ifnull(lPrcCoste +  vCosteUnidad,0);
              NaxAlbaran.AsStringLin['SOL_MODCOSTESADICIONALES'] := 'T';
         end
         else
         if ((uppercase(lObtPrcCoste) = 'MANU')  and (lPrcCoste <> 0)) then
         begin

            NaxAlbaran.AsFloatLin['PrcMedio'] := ifnull(lPrcCoste + vCosteUnidad,0);
            NaxAlbaran.AsStringLin['SOL_MODCOSTESADICIONALES'] := 'T';
         end
         else
         begin

            lPrcCoste := NaxAlbaran.AsFloatLin['PrcMedio'];
           
            NaxAlbaran.AsFloatLin['PrcMedio'] := ifnull(lPrcCoste + vCosteUnidad,0) ;
            NaxAlbaran.AsStringLin['SOL_MODCOSTESADICIONALES'] := 'T';
         end;


      end;

      NaxAlbaran.AnadirLinea;
      showmessage('Añadida linea');
      aGuardadoPorDll[TTablaA3.tipoDocumentoPorParam('AV')] := 'T';
      NaxAlbaran.Anade;
      showmessage('Guardado Albaran');
      next;

    end;

  end;



  NaxAlbaran.Acabar;
end;  }
procedure TdmdDatos.ActualizaCosteLineas(vIdAlbv, vCosteUnidad: double; vModificarCostesManuales: boolean);
var
  NaxAlbaran : albaran;
  NaxVarios  : Varios;
  lLineas    : array of double;
  i          : integer;
  lObtPrcCoste : string;
  lCodArt, lCodAlm : string;
  lPrcCoste  : double;
begin
  // 1) Capturar los numlinalb y CERRAR el cursor antes de tocar el documento
  SetLength(lLineas, 0);
  with qLineasCoste do
  begin
    Close;
    SQL.Clear;
    SQL.Add('select numlinalb from linealba with(nolock)');
    SQL.Add('where idalbv = ' + FormateaFloatSql(vIdAlbv));
    SQL.Add('order by numlinalb');
    Open;
    while not Eof do
    begin
      SetLength(lLineas, Length(lLineas) + 1);
      lLineas[High(lLineas)] := FieldByName('numlinalb').AsFloat;
      Next;
    end;
    Close;
  end;

  if Length(lLineas) = 0 then Exit;

  NaxVarios  := coVarios.Create;
  NaxAlbaran := coAlbaran.Create;
  NaxAlbaran.Iniciar;
  try
    NaxAlbaran.OmitirMensajes := True;
    NaxAlbaran.Modifica(vIdAlbv, False);          // <-- UNA sola vez

    for i := 0 to High(lLineas) do
    begin
      NaxAlbaran.EditarLinea(lLineas[i]);

     { // Leer del propio documento, no del dataset (ya está cerrado)
      lObtPrcCoste := NaxAlbaran.AsStringLin['ObtPrcCoste'];
      lCodArt      := NaxAlbaran.AsStringLin['CodArt'];
      lCodAlm      := NaxAlbaran.AsStringLin['CodAlm'];

      if (UpperCase(lObtPrcCoste) <> 'MANU') or vModificarCostesManuales then
      begin
        lPrcCoste := IfNull(NaxAlbaran.AsFloatLin['SOL_COSTEANTERIOR'], 0);

        if (lPrcCoste = 0) and (UpperCase(lObtPrcCoste) <> 'MANU') then
          lPrcCoste := IfNull(NaxVarios.ObtPrecioCoste(lCodArt, lCodAlm, lObtPrcCoste), 0);

        if (lPrcCoste = 0) and (UpperCase(lObtPrcCoste) = 'MANU') then
          lPrcCoste := NaxAlbaran.AsFloatLin['PrcMedio'];

        NaxAlbaran.AsFloatLin['PrcMedio'] := IfNull(lPrcCoste + vCosteUnidad, 0);
        NaxAlbaran.AsStringLin['SOL_MODCOSTESADICIONALES'] := 'T';
      end;      }

      NaxAlbaran.AnadirLinea;                     // confirma la línea en el buffer
    end;

    aGuardadoPorDll[TTablaA3.tipoDocumentoPorParam('AV')] := 'T';
    NaxAlbaran.Anade;                             // <-- UNA sola vez, graba todo
  finally
    NaxAlbaran.Acabar;
  end;
end;


function TdmdDatos.BuscarNumeroDocumento(vIdDoc: double; vTipo: string): string;
begin
    with query do
  begin
    close;
    sql.Clear;

    sql.Add('Select TipoCont, Serie, NumDoc from '+ TTAblaA3.Tabla(vTipo) + ' with(nolock)');
    sql.Add('where ' + TTablaA3.Codigo(vTipo)+ '  = ' + formateafloatsql(vIdDoc));

    open;

    result := Trim(FieldByName('TipoCont').asstring )  +'/' + Trim(fieldbyname('serie').AsString) + '/' + Inttostr(Trunc(fieldbyname('numdoc').AsFloat));
  end;
end;

function TdmdDatos.BuscarParam(vIdalbv:double; vparametro: string): boolean;
begin
  with query do
  begin
    close;
    sql.Clear;

    sql.Add('Select coalesce(' + vparametro + ',''F'') Parametro from cabealbv with(nolock)');
    sql.Add('where idalbv = ' + formateafloatsql(vIdAlbv));

    open;

    result := FieldByName('parametro').asstring = 'T';
  end;
end;

function TdmdDatos.CalcularBultosArticulo(vCodArt: string; vPaquetes: integer;
  vDocumento: string): integer;
var
   lCampo:string;
begin
  if vdocumento = 'AV' then
      lCampo := 'PaqBulV'
  else
      lCampo := 'PaqBulC';

  with query do
  begin
    close;
    sql.Clear;

    sql.Add('Select '  + lCampo + ' paqbul from articulo with(nolock)' );
    sql.Add('where codart = ' + quotedstr(vCodArt));

    open;
    if fieldbyname('paqbul').AsFloat <> 0 then
       result := Ceil(vPaquetes / fieldbyname('paqbul').AsFloat)
    else
       result := 1;
  end;

end;

function TdmdDatos.CalcularPaquetesArticulo(vCodArt: string; vUnidades: double;
  vDocumento: string): integer;
var
   lCampo:string;
begin
  if vdocumento = 'AV' then
      lCampo := 'UniPaqV'
  else
      lCampo := 'UniPaqC';

  with query do
  begin
    close;
    sql.Clear;

    sql.Add('Select '  + lCampo + ' unipaq from articulo with(nolock)' );
    sql.Add('where codart = ' + quotedstr(vCodArt));

    open;
    if fieldbyname('Unipaq').AsFloat <> 0 then
        result := Ceil(vUnidades / fieldbyname('Unipaq').AsFloat)
    else
