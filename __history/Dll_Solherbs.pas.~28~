var
  lPrcMedioAnt: double;
begin
   if  ((Documento = 'AV') and (estado < 2)) then
   begin
      lPrcMedioAnt := ifnull(TInternoDLL.GetValorCampoVarFloat(Linea, 'SOL_COSTEANTERIOR'),0);


   end;
end;
