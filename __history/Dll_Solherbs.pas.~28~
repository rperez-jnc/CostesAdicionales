procedure INICIAR(Empresa: PAnsiChar); stdcall;
begin
  dxInitialize;
  Bd := TdmdDatos.Create(nil);
  Bd.Conecta(Empresa);
  DatosIniAplicacion := TDatosIniAplicacion.Create;
  bd.IniciaEnlace;
  CambiadoPrcMedio := False;

end;

procedure FINALIZAR; stdcall;
begin
   DatosIniAplicacion.Free;
   bd.FinalizaEnlace;
   Bd.Free;
   dxFinalize;
end;
