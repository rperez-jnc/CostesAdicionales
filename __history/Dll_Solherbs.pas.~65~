procedure DESPUESDEGUARDARDOCUMENTOV2(Documento: AnsiString; IdDoc: Double; Estado: integer); stdcall;
var
  lImporteCosteAdicionales: double;
  lNumUnidades : double;
  lCosteUnidad: double;
  lCajas,  lCostes:boolean;
  li:integer;
begin

    if aGuardadoPorDll[TTablaA3.tipoDocumentoPorParam(Documento)] = 'T' then
    BEGIN
         aGuardadoPorDll[TTablaA3.tipoDocumentoPorParam(Documento)] := 'F';
    END
    ELSE
    BEGIN
        lCajas := true;

        lCostes := true;
        for lI := 0 to DatosIni.UsuariosExcluidosCajasList.Count - 1 do
        if (UPPERCASE(bd.NaxEnlace.Usuario)   = UPPERCASE(DatosIni.UsuariosExcluidosCajasList[li])) then
        begin
            lCajas := False;

        end;

        for lI := 0 to DatosIni.UsuariosExcluidosPaquetesCostes.Count - 1 do
        if (UPPERCASE(bd.NaxEnlace.Usuario)   = UPPERCASE(DatosIni.UsuariosExcluidosPaquetesCostes[li])) then
        begin
            lCostes := False;

        end;
         // VENTAS: nueva regularizacion de cajas independiente de ventas.

        if ((Documento = 'AV') and (Estado < 2) and (IdDoc > 0) and (lCajas) )then
        begin
          try
            Bd.GenerarRegularizacionesAlternativosVenta(IdDoc);
          except
            on E: Exception do
              MessageDlg('Regularizacion de cajas no completada: ' +
                E.Message, mtError, [mbOK], 0);
          end;
        end;

         //ALBARANES
        if ((Documento = 'AV') and (Estado < 2) and not (NoModificarCostes) and (lCostes)) then
        begin
           NoModificarCostes := Bd.BuscarParam(iddoc, DatosIniAplicacion.ParamNoModificarCostes);
           if NoModificarCostes  then
             exit;

           lImporteCosteAdicionales := bd.SumaCostesAdiciones(IdDoc);
           if lImporteCosteAdicionales > 0 then
           begin

               lNumUnidades:= bd.SumaUnidadesLineas(IdDoc, DatosIniAplicacion.ModificarCostesManuales);
               if lNumUnidades > 0 then
               begin
                 lCosteUnidad := lImporteCosteAdicionales /  lNumUnidades;
                 bd.ActualizaCosteLineas(IdDoc,lCosteUnidad , DatosIniAplicacion.ModificarCostesManuales);
               end;
           end
           else  //Si no hay lineas de coste, pongo los costes que devuelve Nax
           begin
             bd.ActualizaCosteLineas(IdDoc,0 ,DatosIniAplicacion.ModificarCostesManuales);
           end;

        end;
        if  ((Documento = 'AC') and (estado < 2)) then
        begin
            CalculoLotes(IdDoc);

        end;
        // SERVIDO AUTOMATICO DE ARTICULOS ALTERNATIVOS
        // Solo al guardar o modificar albaranes de compra.
        if (Documento = 'AC') and
           ((Estado = 0) or (Estado = 1)) and
           (IdDoc > 0) and
           (not ProcesandoAlternativos) then
        begin
          if lPaquetes then
          begin
            ProcesandoAlternativos := True;
            try
              try
                Bd.ProcesarAlternativosAlbaran(IdDoc);
              except
                on E: Exception do
                  MessageDlg(
                    'Error al servir articulos alternativos:' +
                    sLineBreak + E.Message,
                    mtError, [mbOK], 0
                  );
              end;
            finally
              ProcesandoAlternativos := False;
            end;
          end;
        end;

       

    END;
end;

